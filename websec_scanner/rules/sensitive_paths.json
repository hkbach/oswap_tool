{
  "version": "2026.09.30.2",
  "description": "Sensitive paths probed by the sensitive-paths check (SRS table 4.8.1). Each entry needs a content signature (FR-DET-01): a regex on the decoded text and/or magic_hex bytes at the start; HTML pages never match unless allow_html is true. Adding a path is a data change: add an entry here with a stable, unique id.",
  "paths": [
    {"path": ".git/HEAD", "id": "EXPOSURE-GIT-HEAD", "severity": "CRITICAL", "title": "Exposed .git repository metadata", "signature": {"description": "a git HEAD reference", "regex": "\\A(ref: refs/\\S+|[0-9a-f]{40}|[0-9a-f]{64})\\s*\\Z"}},
    {"path": ".git/config", "id": "EXPOSURE-GIT-CONFIG", "severity": "CRITICAL", "title": "Exposed .git repository config", "signature": {"description": "a git config file", "regex": "(?m)^\\[core\\]"}},
    {"path": ".env", "id": "EXPOSURE-ENV", "severity": "CRITICAL", "title": "Exposed .env file (often contains secrets)", "signature": {"description": "KEY=VALUE environment variables", "regex": "(?m)^\\s*(export\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*="}},
    {"path": ".env.local", "id": "EXPOSURE-ENV-LOCAL", "severity": "CRITICAL", "title": "Exposed .env.local file", "signature": {"description": "KEY=VALUE environment variables", "regex": "(?m)^\\s*(export\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*="}},
    {"path": ".env.production", "id": "EXPOSURE-ENV-PRODUCTION", "severity": "CRITICAL", "title": "Exposed .env.production file", "signature": {"description": "KEY=VALUE environment variables", "regex": "(?m)^\\s*(export\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*="}},
    {"path": "wp-config.php.bak", "id": "EXPOSURE-WP-CONFIG-BAK", "severity": "CRITICAL", "title": "Exposed WordPress config backup", "signature": {"description": "PHP source code", "regex": "<\\?php"}},
    {"path": "config.php.bak", "id": "EXPOSURE-CONFIG-PHP-BAK", "severity": "CRITICAL", "title": "Exposed config backup file", "signature": {"description": "PHP source code", "regex": "<\\?php"}},
    {"path": "web.config", "id": "EXPOSURE-WEB-CONFIG", "severity": "MEDIUM", "title": "Exposed IIS web.config", "signature": {"description": "an IIS/ASP.NET configuration file", "regex": "<configuration[\\s>]"}},
    {"path": ".svn/entries", "id": "EXPOSURE-SVN-ENTRIES", "severity": "HIGH", "title": "Exposed Subversion metadata", "signature": {"description": "a Subversion entries file", "regex": "\\A(\\d+\\r?\\n|<\\?xml[^>]*>\\s*<wc-entries)"}},
    {"path": ".DS_Store", "id": "EXPOSURE-DS-STORE", "severity": "LOW", "title": "Exposed macOS .DS_Store (can leak file listing)", "signature": {"description": "a macOS .DS_Store file", "magic_hex": "0000000142756431"}},
    {"path": "docker-compose.yml", "id": "EXPOSURE-DOCKER-COMPOSE", "severity": "HIGH", "title": "Exposed docker-compose.yml", "signature": {"description": "a Docker Compose file", "regex": "(?m)^(services|version)\\s*:"}},
    {"path": "backup.zip", "id": "EXPOSURE-BACKUP-ZIP", "severity": "HIGH", "title": "Exposed backup archive", "signature": {"description": "a ZIP archive", "magic_hex": "504b0304"}},
    {"path": "backup.sql", "id": "EXPOSURE-BACKUP-SQL", "severity": "CRITICAL", "title": "Exposed SQL database dump", "signature": {"description": "an SQL dump", "regex": "(?im)^\\s*(--\\s*(MySQL|MariaDB) dump|--\\s*PostgreSQL database dump|CREATE TABLE|INSERT INTO|DROP TABLE)"}},
    {"path": "phpinfo.php", "id": "EXPOSURE-PHPINFO", "severity": "MEDIUM", "title": "Exposed phpinfo() output", "signature": {"description": "phpinfo() output", "regex": "phpinfo\\(\\)|PHP Version \\d", "allow_html": true}},
    {"path": "server-status", "id": "EXPOSURE-SERVER-STATUS", "severity": "MEDIUM", "title": "Exposed Apache mod_status page", "signature": {"description": "an Apache server-status page", "regex": "Apache Server Status for", "allow_html": true}},
    {"path": "id_rsa", "id": "EXPOSURE-ID-RSA", "severity": "CRITICAL", "title": "Exposed private SSH key", "signature": {"description": "a private key", "regex": "-----BEGIN (RSA |DSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY-----"}},
    {"path": ".well-known/security.txt", "id": "EXPOSURE-SECURITY-TXT", "severity": "INFO", "title": "security.txt present (informational, not a finding)", "signature": {"description": "a security.txt policy (RFC 9116)", "regex": "(?im)^\\s*Contact:\\s*\\S"}}
  ]
}
