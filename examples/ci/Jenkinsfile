// Non-intrusive Web Security Scanner in a Jenkins declarative pipeline.
//
// Only scan systems you own or are authorized to test: --yes skips the interactive
// authorization prompt.
//
// Exit codes: 0 pass, 1 finding at or above --fail-on, 3 target could not be scanned.
pipeline {
    agent { docker { image 'python:3.12-slim' } }

    environment {
        TARGET_URL  = 'https://staging.example.com'  // the approved target
        SCANNER_REF = 'v1.11.0'                       // tag or commit of hkbach/oswap_tool to install
    }

    stages {
        stage('Install the scanner') {
            steps {
                // No apt-get/git: Jenkins' Docker Pipeline plugin runs this container as a
                // non-root user by default, so installing git with apt-get used to fail here.
                // pip installs straight from the tagged source archive over plain HTTPS instead.
                sh 'pip install "https://github.com/hkbach/oswap_tool/archive/refs/tags/${SCANNER_REF}.tar.gz"'
            }
        }
        stage('Scan') {
            steps {
                // Add --ca-bundle path/to/ca.pem if the target uses a private CA.
                sh '''
                    python -m websec_scanner "$TARGET_URL" --yes --no-color \
                      --fail-on high \
                      --json websec-report.json --sarif websec-report.sarif --html websec-report.html
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'websec-report.*', allowEmptyArchive: true
        }
    }
}
